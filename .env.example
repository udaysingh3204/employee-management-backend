# ---- Server ----
PORT=5000
NODE_ENV=development
# Number of reverse-proxy hops to trust for client IPs (set 1 behind Render/Railway/Nginx)
TRUST_PROXY=0

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/employee_management
# Used only by `npm test` when set. Otherwise tests start a throwaway in-memory MongoDB.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/employee_management_test

# ---- JWT ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# ---- OTP (DEVELOPMENT / TESTING ONLY) ----
# The server refuses to start with NODE_ENV=production while this is set.
HARDCODED_OTP=123456
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15

# ---- Roles ----
# Comma-separated emails that become "admin" when they sign up. Everyone else is "user".
ADMIN_EMAILS=admin@example.com

# ---- Security ----
# Comma-separated allowed origins, or * for any
CORS_ORIGINS=*
BODY_LIMIT=10kb
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=50
